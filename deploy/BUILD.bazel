load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")

package(default_visibility = ["//visibility:public"])

_linux_amd64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

# R-C268: refuse a shipped binary that carries a build-machine path. An
# `/execroot/` or `/sandbox/` string is the unremapped C debug path that made
# SWB-R53 irreproducible; a `/nix/store/` string means a toolchain path
# reached the binary: a Nix gcc-wrapper (which would also ask for a Nix
# dynamic linker the distroless base does not have), or zig's libc headers
# through sanitizer source locations (R-C416 turns those off in //tools/cc).
# The output is a byte copy, so the layer is unchanged when the check passes.
genrule(
    name = "swb_checked",
    srcs = ["//crates/swb:swb"],
    outs = ["swb"],
    cmd = """
if grep -a -q -e /execroot/ -e /sandbox/ -e /nix/store/ $<; then
  echo "R-C268: $< embeds a build-machine path; the image would not be reproducible" >&2
  grep -a -o -e '[^[:cntrl:]]*/execroot/[^[:cntrl:]]*' -e '[^[:cntrl:]]*/sandbox/[^[:cntrl:]]*' -e '[^[:cntrl:]]*/nix/store/[^[:cntrl:]]*' $< | head -5 >&2
  exit 1
fi
cp $< $@
chmod 0755 $@
""",
    target_compatible_with = _linux_amd64,
)

# The swb binary as an image layer. Every entry is 0:0 with the portable
# mtime, so the tar depends only on the binary's bytes.
pkg_tar(
    name = "swb_layer",
    srcs = [":swb_checked"],
    mode = "0755",
    owner = "0.0",
    package_dir = "/usr/local/bin",
    portable_mtime = True,
    target_compatible_with = _linux_amd64,
)

# R-C268: OCI labels. `source` is constant. `revision` is the commit passed as
# `--embed_label=<40-hex sha>`, read from the stable
# workspace status; without it the value is `unstamped`. Only that one key is
# read, so BUILD_HOST, BUILD_USER and the volatile status never reach the
# image. Any other embed label fails the build. A release passes the
# approved-broker.json `source` (`just release-image`), not the tag or HEAD,
# so the label and the digest do not move when the tag sits on a later commit.
genrule(
    name = "image_labels",
    outs = ["image_labels.txt"],
    cmd = """
rev=$$(sed -n 's/^BUILD_EMBED_LABEL //p' bazel-out/stable-status.txt)
case "$$rev" in
  "") rev=unstamped ;;
  *[!0-9a-f]*) echo "R-C268: --embed_label must be a 40-hex commit sha, got '$$rev'" >&2; exit 1 ;;
esac
if [ "$$rev" != unstamped ] && [ $${#rev} -ne 40 ]; then
  echo "R-C268: --embed_label must be a 40-hex commit sha, got '$$rev'" >&2
  exit 1
fi
printf 'org.opencontainers.image.revision=%s\norg.opencontainers.image.source=https://github.com/xoxd-ai/agent-switchboard\n' "$$rev" > $@
""",
    stamp = True,
)

# SWB-R04: a pinned Linux/amd64 runtime. The nonroot base runs as UID 65532;
# blahaj owns the PVC's writable directory and the exact tailnet Host gate.
oci_image(
    name = "image",
    base = "@distroless_cc_amd64_linux_amd64",
    entrypoint = ["/usr/local/bin/swb"],
    cmd = ["serve"],
    labels = ":image_labels",
    tars = [":swb_layer"],
    target_compatible_with = _linux_amd64,
)

# SWB-R04, R-N13: explicit digest-only publication. `oci_push` uploads by
# digest without a mutable tag; the matching :image.digest is the blahaj input.
# Run only from a reviewed main commit, never as part of PR CI.
oci_push(
    name = "push",
    image = ":image",
    repository = "ghcr.io/xoxd-ai/agent-switchboard",
    target_compatible_with = _linux_amd64,
)

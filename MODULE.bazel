# agent-switchboard Bazel module. Bazel is the build, test and package
# authority; Cargo is a diagnostic mirror (see AGENTS.md).
#
# Pins follow xoxd-ai/prompt-pulse, the estate's proven rules_rust +
# crate_universe reference on Bazel 9.2.0. CI (xoxd-ai/ci-templates
# rust-bazel-application.yml) runs every Bazel command with
# --ignore_all_rc_files, so nothing in .bazelrc may be load-bearing.

module(
    name = "agent_switchboard",
    version = "0.2.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_nixpkgs_core", version = "0.13.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

# SWB-R04: keep the Linux runtime base immutable and platform-specific.
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_cc_amd64",
    image = "gcr.io/distroless/cc-debian13",
    digest = "sha256:54df941ed0d06a1bd95ef5e0ce391fd8d9f94b64782dc9a60062727849ee3f97",
    platforms = ["linux/amd64"],
)
use_repo(oci, "distroless_cc_amd64", "distroless_cc_amd64_linux_amd64")

RUST_TRIPLES = [
    "aarch64-apple-darwin",
    "x86_64-apple-darwin",
    "aarch64-unknown-linux-gnu",
    "x86_64-unknown-linux-gnu",
]

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = RUST_TRIPLES,
    versions = ["1.97.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:cargo-bazel-lock.json",
    # The workspace root is enough: crate_universe discovers the members.
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = RUST_TRIPLES,
)
use_repo(crate, "crates")

# R-C416 (TIN-4655): the pinned Nix C toolchain. tools/cc/nixpkgs.nix pins
# the nixpkgs (the flake.lock revision, by NAR hash) and tools/cc/zig_cc.nix
# builds the zig cc wrappers from it; both are release-protected inputs under
# tools/. Registered before rules_cc's host autodetection, so Linux x86_64
# builds never look for a host gcc and the image no longer depends on the
# build machine's compiler (amends R-C282). Bazel needs `nix-build` on PATH
# to fetch it.
nix_repo = use_extension("@rules_nixpkgs_core//extensions:repository.bzl", "nix_repo")
nix_repo.file(
    name = "swb_nixpkgs",
    file = "//tools/cc:nixpkgs.nix",
)
use_repo(nix_repo, "swb_nixpkgs")

nix_pkg = use_extension("@rules_nixpkgs_core//extensions:package.bzl", "nix_pkg")
nix_pkg.file(
    name = "swb_zig_cc",
    attr = "",
    build_file = "//tools/cc:zig_cc.BUILD",
    file = "//tools/cc:zig_cc.nix",
    file_deps = ["//tools/cc:nixpkgs.nix"],
    repo = "@swb_nixpkgs",
)
use_repo(nix_pkg, "swb_zig_cc")

register_toolchains("//tools/cc:zig_x86_64_linux_toolchain")
